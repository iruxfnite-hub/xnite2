generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                               String    @id @default(uuid())
  email                            String    @unique
  name                             String
  role                             String    @default("applicant")
  status                           String    @default("Active")
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  password                         String?
  facebook                         String?
  phone                            String?
  refererEmail                     String?
  hasCompletedPreCourse            Boolean   @default(false)
  isRegistered                     Boolean   @default(false)
  isDashboardCompleted             Boolean   @default(false)
  gingerPassword                   String?
  gingerEmail                      String?   @unique
  gingerUsername                   String?   @unique
  onboardingProgress               Json?
  firstName                        String?
  lastName                         String?
  isRulesAndGuidelinesCompleted    Boolean   @default(false)
  onRulesAndGuidelinesProgress     Json?
  lastLogin                        DateTime?
  hasClickedLandCoverTraining      Boolean   @default(false)
  hasClickedTransportationTraining Boolean   @default(false)
  landCoverProgress                Json?
  transportationProgress           Json?
  activeProjectsTutorialProgress   Json?
  linkedRecruiterEmail             String?
  group_id                         Int?
  team_id                          Int?
  labelerId                        String?
  labelerPassword                  String?
  sidebarBannerUrl                 String?
  labelerRefererEmail              String?
  username                         String?   @unique
  acknowledgedPerformanceAlerts    Json?     @default("[]")

  @@index([refererEmail])
  @@index([createdAt(sort: Desc)])
  @@index([gingerEmail])
  @@index([gingerUsername])
  @@index([username])
}

model Project {
  id              String   @id @default(uuid())
  projectId       String
  nameDesignation String
  status          String
  endDate         DateTime
  taskNum         Int
  registeredHours Float
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, projectId])
}

model SoftwareCredential {
  id          String   @id @default(uuid())
  role        String
  softwareUid String   @unique
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentDetails {
  id            String   @id @default(uuid())
  email         String   @unique
  payeeName     String?
  payeeUid      String?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  qrImageUrl    String?
  lastName      String?
}

model PaymentMethodHistory {
  id               String   @id @default(uuid())
  email            String
  oldPayeeName     String?
  oldPayeeUid      String?
  oldPaymentMethod String?
  newPayeeName     String?
  newPayeeUid      String?
  newPaymentMethod String?
  changedAt        DateTime @default(now())
  oldQrImageUrl    String?
  newQrImageUrl    String?
  oldLastName      String?
  newLastName      String?
}

model CurrentIncome {
  id                 String    @id @default(uuid())
  email              String    @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  estimatedAmount    Float     @default(0)
  status             String    @default("Accumulating")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rawComputation     Json?
}

model IncomeHistory {
  id             String    @id @default(uuid())
  email          String
  amountPaid     Float
  periodStart    DateTime?
  periodEnd      DateTime?
  payoutDate     DateTime?
  status         String    @default("Paid")
  transactionId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  rawComputation Json?
}

model Referal {
  id         String   @id @default(uuid())
  email      String   @unique
  code       String
  status     String   @default("Active")
  howManyUse Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  name       String?
  username   String?
  sitename   String   @default("XFd_")
}

model Ranking {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  balance   Float
  rank      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckerRanking {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  balance   Float
  rank      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Training {
  id        String   @id @default(uuid())
  userId    String   @unique
  trainings Json[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id            String   @id @default(uuid())
  chatType      String
  sender        String
  senderRole    String?
  text          String
  createdAt     DateTime @default(now())
  isEdited      Boolean  @default(false)
  updatedAt     DateTime @default(now()) @updatedAt
  imageUrl      String?
  replyToId     String?
  replyToSender String?
  replyToText   String?
  senderEmail   String?

  @@index([chatType, createdAt])
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Attendance {
  id             String   @id
  createdAt      DateTime @default(now())
  createdBy      String?
  date           DateTime @default(now())
  password       String
  title          String
  createdByEmail String?
  slug           String   @unique @default(dbgenerated("gen_random_uuid()"))
}

model AttendanceSession {
  id             String   @id
  meetingId      String
  userEmail      String
  userName       String
  attendedAt     DateTime @default(now())
  facebook       String?
  gingerUsername String?

  @@unique([meetingId, userEmail])
}

model Group {
  id            String   @id
  groupName     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  groupId       Int      @unique
  groupType     String   @default("group")
  managerEmail  String?
  ownerEmail    String?
  checkerLink   String?
  judgerLink    String?
  checkerName   String?
  judgerName    String?
  parentGroupId Int?
}

model work_logs {
  id           Int       @default(autoincrement())
  owner_name   String
  project_id   Int
  role         String
  worktime     Float
  task_num     Int
  features     Int
  uuid         String    @id @default(dbgenerated("gen_random_uuid()"))
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now())
  period_end   DateTime?
  period_start DateTime?

  @@unique([owner_name, project_id, role])
  @@index([owner_name])
  @@index([project_id])
}

model DirectMessage {
  id        String   @id
  toEmail   String
  fromName  String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  imageUrls String?

  @@index([toEmail, isRead])
}

model AutomatedChatMessage {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  chatType   String
  senderName String?   @default("Lia")
  senderRole String?   @default("moderator")
  message    String
  frequency  Int
  isActive   Boolean   @default(true)
  startTime  DateTime?
  endTime    DateTime?
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@index([isActive])
}

model BroadcastMessage {
  id        String   @id
  fromName  String
  subject   String
  message   String
  imageUrls String?
  createdAt DateTime @default(now())
}

model JukeboxListening {
  id        String   @id
  userEmail String
  periodKey String
  minutes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([userEmail, periodKey])
}

model LoyaltyRank {
  id        String   @id
  rankNum   Int      @unique
  name      String
  minLxp    Int
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model MessageRecipient {
  id                 String  @id
  broadcastMessageId String
  toEmail            String
  isRead             Boolean @default(false)

  @@index([broadcastMessageId])
  @@index([toEmail, isRead])
}

model ProfileChangeRequest {
  id                 String    @id
  userEmail          String
  requestedFirstName String?
  requestedLastName  String?
  requestedFacebook  String?
  status             String    @default("PENDING")
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime

  @@index([status])
  @@index([userEmail])
}

model TorchHelp {
  id          String   @id
  helperEmail String
  helpedEmail String
  periodKey   String
  messageId   String?
  createdAt   DateTime @default(now())

  @@unique([helpedEmail, periodKey])
  @@index([helperEmail, periodKey])
}

model UserLoyalty {
  id              String   @id
  email           String   @unique
  totalLxp        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  completedQuests Json     @default("[]")
  completionsDate DateTime @default(now()) @db.Date
  questProgress   Json     @default("{}")

  @@index([email])
}

model WeeklyQuestClaim {
  id        String   @id
  email     String
  questId   String
  weekKey   String
  lxp       Int
  createdAt DateTime @default(now())

  @@unique([email, questId, weekKey])
  @@index([email, weekKey])
}
